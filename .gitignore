# 依赖
node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo

# 桌面版打包产物（electron-builder 输出）
/release/

# 运行时数据（服务台账、日志缓存等）
# 注意：必须锚定到仓库根（前导 /）。写裸 `data/` 会匹配任意深度的 data 目录，
# 曾把源码目录整个吞掉（server/src/logs/ 就是这么丢的）。
/data/

# 日志
*.log
/logs/

# 环境变量
.env
.env.local
.env.*.local

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/

# 测试产物
coverage/
.nyc_output/
playwright-report/
test-results/
