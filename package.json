{
  "name": "local-service-console",
  "version": "1.0.0",
  "private": true,
  "description": "Windows 本机服务统一管理控制台：登记 .bat 服务、一键启停重启、tail 日志文件（1s 轮询）",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "bundle:server": "npm run bundle --workspace desktop",
    "desktop": "npm run bundle:server && node scripts/launch-desktop.mjs",
    "dist": "npm run build && npm run bundle:server && electron-builder",
    "verify:bundle": "node scripts/verify-bundle.mjs desktop/build/server.bundle.mjs",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:cov": "npm run test:cov --workspace server && npm run test:cov --workspace client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  }
}
